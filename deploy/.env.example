DB_USERNAME=gamemate
DB_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION=86400000

# Website origins are comma-separated. Keep gamemate://app for the Windows client.
GAME_MATE_ALLOWED_ORIGINS=gamemate://app,https://www.example.com

AI_ENABLED=true
AI_PROVIDER=qwen
AI_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
AI_API_KEY=replace-only-on-the-server
AI_MODEL=qwen-plus
AI_VISION_MODEL=qwen-vl-plus

# 第二层应用防火墙。第一层 Nginx 网关的规则在 gateway/nginx.conf。
GAME_MATE_FIREWALL_ENABLED=true
GAME_MATE_FIREWALL_GENERAL_PER_MINUTE=240
GAME_MATE_FIREWALL_AUTH_PER_FIVE_MINUTES=12
