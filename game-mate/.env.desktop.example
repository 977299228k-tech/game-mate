# Desktop clients must call the public HTTPS address of the cloud backend.
DESKTOP_API_BASE_URL=https://api.example.com

# Generic update directory containing latest.yml, installer and blockmap files.
DESKTOP_UPDATE_URL=https://download.example.com/ai-esports-manager
DESKTOP_UPDATE_CHANNEL=latest

# Optional Windows code-signing settings consumed by electron-builder.
CSC_LINK=C:\secure\codesign-certificate.pfx
CSC_KEY_PASSWORD=replace-with-certificate-password
WINDOWS_PUBLISHER_NAME=Your Company Name
REQUIRE_CODE_SIGNING=true

